<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shape of My Heart ❤️</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      overflow: hidden;
      background:
        radial-gradient(circle at center, #301020 0%, #100612 45%, #030105 100%);
      color: white;
      font-family: Arial, sans-serif;
      height: 100vh;
    }

    .container {
      position: relative;
      width: 100%;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      overflow: hidden;
    }

    /* Background glow */
    .glow {
      position: absolute;
      width: 400px;
      height: 400px;
      background: #ff1744;
      filter: blur(140px);
      opacity: .18;
      border-radius: 50%;
      animation: glow 3s infinite alternate;
    }

    @keyframes glow {
      from {
        transform: scale(.8);
        opacity: .12;
      }
      to {
        transform: scale(1.3);
        opacity: .28;
      }
    }

    /* Heart */
    .heart {
      position: relative;
      width: 150px;
      height: 150px;
      background: linear-gradient(135deg, #ff1744, #ff4081);
      transform: rotate(-45deg);
      box-shadow:
        0 0 30px #ff1744,
        0 0 80px #ff1744,
        0 0 130px rgba(255, 23, 68, .5);
      animation: heartbeat 1.2s infinite ease-in-out;
      z-index: 5;
    }

    .heart::before,
    .heart::after {
      content: "";
      position: absolute;
      width: 150px;
      height: 150px;
      background: inherit;
      border-radius: 50%;
    }

    .heart::before {
      top: -75px;
      left: 0;
    }

    .heart::after {
      top: 0;
      left: 75px;
    }

    @keyframes heartbeat {
      0%, 100% {
        transform: rotate(-45deg) scale(1);
      }
      15% {
        transform: rotate(-45deg) scale(1.12);
      }
      30% {
        transform: rotate(-45deg) scale(1);
      }
      45% {
        transform: rotate(-45deg) scale(1.08);
      }
      60% {
        transform: rotate(-45deg) scale(1);
      }
    }

    /* Title */
    .title {
      position: absolute;
      top: 9%;
      text-align: center;
      z-index: 10;
    }

    .title h1 {
      font-size: clamp(32px, 7vw, 72px);
      letter-spacing: 6px;
      text-transform: uppercase;
      text-shadow:
        0 0 10px #fff,
        0 0 30px #ff1744;
      animation: titleGlow 2s infinite alternate;
    }

    .title p {
      margin-top: 12px;
      color: #ffb6c8;
      letter-spacing: 5px;
      font-size: 13px;
    }

    @keyframes titleGlow {
      from {
        text-shadow:
          0 0 10px #fff,
          0 0 20px #ff1744;
      }
      to {
        text-shadow:
          0 0 20px #fff,
          0 0 50px #ff1744,
          0 0 80px #ff1744;
      }
    }

    /* Particles */
    .particle {
      position: absolute;
      bottom: -20px;
      width: 4px;
      height: 4px;
      background: #ff6b91;
      border-radius: 50%;
      box-shadow: 0 0 10px #ff1744;
      animation: float linear infinite;
    }

    @keyframes float {
      from {
        transform: translateY(0) scale(.5);
        opacity: 0;
      }
      15% {
        opacity: 1;
      }
      to {
        transform: translateY(-110vh) scale(1.5);
        opacity: 0;
      }
    }

    /* Ring */
    .ring {
      position: absolute;
      width: 280px;
      height: 280px;
      border: 1px solid rgba(255, 64, 129, .4);
      border-radius: 50%;
      animation: ring 4s linear infinite;
    }

    .ring:nth-child(2) {
      width: 400px;
      height: 400px;
      animation-duration: 6s;
    }

    @keyframes ring {
      from {
        transform: scale(.7);
        opacity: 0;
      }
      50% {
        opacity: 1;
      }
      to {
        transform: scale(1.4);
        opacity: 0;
      }
    }

    /* Music button */
    .controls {
      position: absolute;
      bottom: 8%;
      z-index: 20;
      text-align: center;
    }

    button {
      border: 1px solid rgba(255,255,255,.4);
      background: rgba(255, 23, 68, .15);
      color: white;
      padding: 14px 28px;
      border-radius: 50px;
      cursor: pointer;
      font-size: 15px;
      backdrop-filter: blur(10px);
      box-shadow: 0 0 25px rgba(255,23,68,.3);
      transition: .3s;
    }

    button:hover {
      background: rgba(255,23,68,.4);
      transform: scale(1.05);
      box-shadow: 0 0 40px rgba(255,23,68,.7);
    }

    .hint {
      margin-top: 10px;
      font-size: 11px;
      color: #aaa;
    }

    /* Equalizer */
    .equalizer {
      position: absolute;
      bottom: 3%;
      display: flex;
      gap: 5px;
      opacity: .7;
    }

    .bar {
      width: 4px;
      height: 20px;
      background: #ff4081;
      border-radius: 5px;
      animation: equalize .7s infinite alternate;
    }

    .bar:nth-child(2) { animation-delay: .1s; }
    .bar:nth-child(3) { animation-delay: .2s; }
    .bar:nth-child(4) { animation-delay: .3s; }
    .bar:nth-child(5) { animation-delay: .4s; }
    .bar:nth-child(6) { animation-delay: .2s; }
    .bar:nth-child(7) { animation-delay: .1s; }

    @keyframes equalize {
      from { height: 5px; }
      to { height: 35px; }
    }

    @media (max-width: 600px) {
      .heart {
        width: 100px;
        height: 100px;
      }

      .heart::before,
      .heart::after {
        width: 100px;
        height: 100px;
      }

      .heart::before {
        top: -50px;
      }

      .heart::after {
        left: 50px;
      }
    }
  </style>
</head>

<body>

  <div class="container">

    <div class="glow"></div>

    <div class="title">
      <h1>Shape of My Heart</h1>
      <p>❤️ A little piece of my heart ❤️</p>
    </div>

    <div class="ring"></div>
    <div class="ring"></div>

    <div class="heart"></div>

    <div class="controls">
      <button id="musicBtn">▶ Play Music</button>
      <div class="hint">Tambahkan file "lagu.mp3" di folder yang sama</div>
    </div>

    <div class="equalizer">
      <div class="bar"></div>
      <div class="bar"></div>
      <div class="bar"></div>
      <div class="bar"></div>
      <div class="bar"></div>
      <div class="bar"></div>
      <div class="bar"></div>
    </div>

    <audio id="music" loop>
      <source src="lagu.mp3" type="audio/mpeg">
    </audio>

  </div>

  <script>
    const container = document.querySelector(".container");
    const music = document.getElementById("music");
    const button = document.getElementById("musicBtn");
    const heart = document.querySelector(".heart");

    // Membuat partikel
    for (let i = 0; i < 80; i++) {
      const particle = document.createElement("div");

      particle.className = "particle";

      particle.style.left = Math.random() * 100 + "%";
      particle.style.animationDuration =
        (4 + Math.random() * 8) + "s";

      particle.style.animationDelay =
        Math.random() * 8 + "s";

      particle.style.opacity =
        Math.random();

      container.appendChild(particle);
    }

    // Tombol musik
    button.addEventListener("click", () => {

      if (music.paused) {
        music.play();

        button.innerHTML = "❚❚ Pause Music";

        heart.style.animationDuration = "0.7s";

      } else {
        music.pause();

        button.innerHTML = "▶ Play Music";

        heart.style.animationDuration = "1.2s";
      }

    });

    // Efek klik di layar
    document.addEventListener("click", (event) => {

      if (event.target.tagName === "BUTTON") return;

      const x = event.clientX;
      const y = event.clientY;

      for (let i = 0; i < 8; i++) {

        const spark = document.createElement("div");

        spark.style.position = "fixed";
        spark.style.left = x + "px";
        spark.style.top = y + "px";
        spark.style.width = "5px";
        spark.style.height = "5px";
        spark.style.borderRadius = "50%";
        spark.style.background = "#ff4081";
        spark.style.boxShadow = "0 0 15px #ff1744";
        spark.style.pointerEvents = "none";
        spark.style.zIndex = "100";

        const angle = Math.random() * Math.PI * 2;
        const distance = 50 + Math.random() * 100;

        spark.animate([
          {
            transform: "translate(0,0)",
            opacity: 1
          },
          {
            transform:
              `translate(${Math.cos(angle) * distance}px,
                         ${Math.sin(angle) * distance}px)`,
            opacity: 0
          }
        ], {
          duration: 700,
          easing: "ease-out"
        });

        document.body.appendChild(spark);

        setTimeout(() => spark.remove(), 700);
      }
    });
  </script>

</body>
</html>
